# Zero-cost local mode
KMS_PROVIDER=local
KMS_STORE=memory
KMS_EMBEDDING_DIMENSION=256

# Production FPT Cloud AI + Qdrant mode
# KMS_PROVIDER=fpt
# KMS_STORE=qdrant
# FPT_API_KEY=
# FPT_BASE_URL=https://mkp-api.fptcloud.com
# FPT_EMBEDDING_PATH=/embeddings
# FPT_RERANK_PATH=/rerank
# FPT_CHAT_PATH=/chat/completions
# FPT_EMBEDDING_MODEL=multilingual-e5-large
# FPT_RERANK_MODEL=bge-reranker-v2-m3
# FPT_CHAT_MODEL=DeepSeek-V4-Flash
# FPT_VISION_MODEL=gemma-4-26B-A4B-it
