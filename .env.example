# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=automotive_office_kms

KMS_CHUNK_MAX_WORDS=380
KMS_RETRIEVAL_CANDIDATES=50
KMS_EVIDENCE_LIMIT=5
KMS_MINIMUM_SCORE=0.12
KMS_REQUEST_TIMEOUT_SECONDS=90

